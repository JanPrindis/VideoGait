/* --- GLOBAL LAYOUT --- */
Screen {
    align: center middle;
    layers: base modal;
    background: $surface;
}

/* --- MODAL WINDOWS --- */
.modal-container {
    width: 90%;
    height: 90%;
    background: $surface;
    border: heavy $accent;
    layout: vertical;
}

.modal-header {
    width: 100%;
    height: 3;
    content-align: center middle;
    background: transparent;
    color: $text-accent;
    text-style: bold;
    border-bottom: solid $secondary;
}

/* --- NAV BAR --- */
.nav-bar {
    height: 3;
    width: 100%;
    background: $surface;
    border-bottom: solid $secondary;
    padding: 0 1;
    align: left middle;
}

.nav-buttons-group {
    width: auto;
    height: auto;
    margin-right: 1;
    layout: horizontal;
}

.nav-btn {
    height: 1;
    min-width: 3;
    border: none;
    background: $primary-darken-2;
    color: $text;
    margin-right: 1;
    content-align: center middle;
}
.nav-btn:hover {
    background: $accent;
    color: $text;
}

.nav-btn.-disabled {
    background: $surface-darken-1;
    color: $text-muted;
}

#path_display {
    height: 1;
    width: 1fr;
    background: $surface-darken-1;
    color: $text-accent;
    padding: 0 1;
    content-align: left middle;
}

/* --- DIRECTORY TREE --- */
DirectoryTree, FilteredDirectoryTree {
    height: 1fr;
    width: 100%;
    background: $surface;
    padding: 0 1;
}

/* --- FOOTER --- */
.modal-footer {
    height: auto;
    width: 100%;
    background: $surface-darken-1;
    padding: 1;
    border-top: solid $secondary;
    align: center middle;
}

.modal-footer Button { margin-left: 1; }
.btn-left { margin-left: 0 !important; margin-right: 1; }
.spacer { width: 1fr; background: transparent; }

.input-modal {
    width: 60;
    height: auto;
    background: $surface;
    border: heavy $warning;
    padding: 2;
    align: center middle;
}

/* --- SIDEBAR --- */
#sidebar {
    dock: left;
    width: 40%;
    max-width: 50;
    height: 100%;
    background: $surface-darken-1;
    border-right: solid $primary;
    padding: 1 2;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#sidebar Label {
    margin-top: 1;
    color: $text-muted;
    width: 100%;
}

#sidebar Button {
    width: 100%;
    margin-top: 1;
    height: 3;
    content-align: center middle;
}

#sidebar Select {
    margin-top: 1;
    width: 100%;
}

/* --- OUTPUT AREA & TQDM BAR --- */
#output-area {
    height: 100%;
    width: 100%;
    padding: 0;
    margin: 0;
}

RichLog {
    height: 1fr;
    width: 100%;
    background: $surface;
    border: none;
    scrollbar-size: 1 1;
    padding: 0 1;
}

/* TQDM Status Bar */
.status-box {
    height: 1;
    width: 100%;
    max-width: 100%;

    background: $primary-darken-2;
    color: $text;
    padding: 0 1;

    content-align: center middle;
    text-align: center;

    text-wrap: nowrap;
    overflow: hidden;
    border: none;
}

.mt-2 { margin-top: 2; }